# =============================================================================
# BitScope 환경 변수 설정 예제
#
# 이 파일을 .env로 복사하여 실제 환경에 맞게 값을 변경한다.
#   cp .env.example .env
#
# 주의: .env 파일은 .gitignore에 의해 Git에 커밋되지 않는다.
# =============================================================================

# ---------------------------------------------------------------------------
# nginx 설정
# ---------------------------------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443

# ---------------------------------------------------------------------------
# MySQL 데이터베이스 설정
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=bitscope_root_change_me
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=bitscope
DB_PASSWORD=bitscope_change_me
DB_DATABASE=bitscope
DB_CONNECTION_LIMIT=10
DB_LOGGING=false

# ---------------------------------------------------------------------------
# Next.js (프론트엔드) 설정
# ---------------------------------------------------------------------------
# 클라이언트에서 NestJS 백엔드 API에 접근할 때 사용하는 URL
# nginx를 통해 /api/backend/* 경로로 라우팅됨
NEXT_PUBLIC_API_URL=http://localhost/api/backend

# 클라이언트에서 Socket.IO WebSocket 연결 시 사용하는 URL
NEXT_PUBLIC_WS_URL=http://localhost

# WalletConnect 프로젝트 ID (https://cloud.walletconnect.com 에서 발급)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# NestJS (백엔드) 설정
# ---------------------------------------------------------------------------
# CORS 허용 오리진 (쉼표 구분)
# 로컬 개발 시 Next.js가 3500에서 실행되므로 해당 포트를 포함한다.
CORS_ORIGINS=http://localhost:3500,http://localhost:3000

# NestJS 백엔드 포트 (Docker에서는 4000, 로컬 개발에서도 기본 4000)
API_PORT=4000

# ---------------------------------------------------------------------------
# 클라이언트에서 NestJS 백엔드에 직접 접근할 때 사용하는 URL
# nginx 프록시를 사용하지 않는 로컬 개발 환경에서 필요하다.
# Docker/프로덕션에서는 NEXT_PUBLIC_API_URL을 통해 nginx 프록시를 사용한다.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# SSL/도메인 설정 (도메인 확보 후 설정)
# ---------------------------------------------------------------------------
# DOMAIN=bitscope.example.com
# CERTBOT_EMAIL=admin@example.com
